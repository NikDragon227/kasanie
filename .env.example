POSTGRES_DB=kasanie
POSTGRES_USER=kasanie
POSTGRES_PASSWORD=kasanie-dev
ConnectionStrings__DefaultConnection=Host=db;Port=5432;Database=kasanie;Username=kasanie;Password=kasanie-dev
ASPNETCORE_ENVIRONMENT=Development
APP_DOMAIN=localhost
APP_BASE_URL=http://localhost
COOKIE_SECURE=false
# Prod: транзакционная почта через Unisender Go (тариф «Стартовый 6К»).
#   SMTP_HOST=smtp.go2.unisender.ru   (сервер смотри в Unisender Go → SMTP, бывает go1/go2/...)
#   SMTP_PORT=587                     (TLS = STARTTLS; код: 465 → implicit TLS, иначе STARTTLS при SMTP_USE_SSL=true)
#   SMTP_USERNAME — числовой ID аккаунта Unisender Go (не email!), он же «Логин» на странице SMTP
#   SMTP_PASSWORD — API-ключ Unisender Go (тумблер «Доступ к API» должен быть включён)
#   SMTP_FROM — любой адрес на подтверждённом домене, напр. no-reply@prokasanie.ru
# Отправка идёт через MailKit (см. Infrastructure/EmailSender.cs).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@kasanie.local
SMTP_USE_SSL=true
# Куда команда получает уведомление о новом обращении из формы feedback.
SMTP_SUPPORT_INBOX=
ANALYTICS_MINIMUM_GROUP_SIZE=3
PUBLIC_DISCOVERY_ENABLED=true
VITE_YANDEX_MAPS_API_KEY=
# Номер счётчика Яндекс Метрики. Пусто = Метрика не загружается.
VITE_YANDEX_METRIKA_ID=
YANDEX_GEOCODER_API_KEY=
BootstrapAdmin__Email=
BootstrapAdmin__Password=
# Трекинг ошибок. Пусто = выключено, ничего не шлётся.
# sentry.io недоступен из РФ (403) — используем hosted Bugsink (kasanie.bugsink.com).
# Один и тот же DSN в обе переменные:
#   SENTRY_DSN — бэкенд (api)
#   VITE_SENTRY_DSN — фронт, вшивается при сборке web
# Вид: https://KEY@kasanie.bugsink.com/1
SENTRY_DSN=
VITE_SENTRY_DSN=
# Обязательные реквизиты перед public launch. Эти значения встраиваются в публичные страницы документов.
VITE_LEGAL_OPERATOR_NAME=
VITE_LEGAL_OPERATOR_ADDRESS=
VITE_LEGAL_OPERATOR_TAX_ID=
VITE_PRIVACY_CONTACT=
VITE_SUPPORT_EMAIL=
