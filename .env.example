POSTGRES_DB=kasanie
POSTGRES_USER=kasanie
POSTGRES_PASSWORD=kasanie-dev
ConnectionStrings__DefaultConnection=Host=db;Port=5432;Database=kasanie;Username=kasanie;Password=kasanie-dev
ASPNETCORE_ENVIRONMENT=Development
APP_DOMAIN=localhost
APP_BASE_URL=http://localhost
COOKIE_SECURE=false
# Prod (временно, до публичного запуска): обычный ящик Яндекса.
#   SMTP_HOST=smtp.yandex.ru
#   SMTP_PORT=587
#   SMTP_USERNAME и SMTP_FROM — один и тот же ящик (Яндекс отклонит несовпадение)
#   SMTP_PASSWORD — пароль приложения из Яндекс ID (не пароль аккаунта), нужен включённый IMAP
# Перед выводом платформы в свет заменить на доменную почту / транзакционный сервис — см. docs/ROADMAP.md (1A).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@kasanie.local
SMTP_USE_SSL=true
ANALYTICS_MINIMUM_GROUP_SIZE=3
PUBLIC_DISCOVERY_ENABLED=true
VITE_YANDEX_MAPS_API_KEY=
YANDEX_GEOCODER_API_KEY=
BootstrapAdmin__Email=
BootstrapAdmin__Password=
