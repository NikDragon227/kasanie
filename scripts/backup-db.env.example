# Off-site бэкапы Касания. Скопировать на прод в ~/.kasanie-backup.env и chmod 600.
# Пустой файл / его отсутствие = backup-db.sh работает как раньше (только локальный dump).

# --- Шифрование (AES-256, openssl) ---
# Без пароля дамп (в т.ч. off-site копия) лежит в открытом виде — а там ПДн.
# Длинная случайная строка. Потеряешь её — восстановить бэкап нельзя. Храни отдельно.
BACKUP_PASSPHRASE=

# --- Off-site назначение (rclone) ---
# Один раз на сервере:  apt install rclone  &&  rclone config
# (подойдёт Backblaze B2, любой S3, Яндекс.Диск по WebDAV, SFTP на другой сервер и т.д.)
# Значение — <remote>:<путь>, например: b2:kasanie-backups  или  yandexdisk:kasanie
BACKUP_REMOTE=

# --- Ротация ---
BACKUP_KEEP_LOCAL=7          # сколько последних наборов держать на сервере
BACKUP_KEEP_REMOTE_DAYS=30   # удалять в off-site всё старше N дней
